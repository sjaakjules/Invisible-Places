#version 450
#extension GL_GOOGLE_include_directive : require

#include "rain_impact_rock_model.glsl"
#include "rain_impact_sand_model.glsl"

struct RockRainImpactTestInput {
    vec4 eventPositionRadius;
    vec4 eventNormalLifetime;
    vec4 pointAge;
    vec4 pointNormal;
    uvec4 control;
    vec4 rockImpact0;
    vec4 rockImpact1;
};

layout(set = 0, binding = 0, std430) readonly buffer TestInputs {
    RockRainImpactTestInput inputs[];
};

layout(set = 0, binding = 1, std430) writeonly buffer TestOutputs {
    float outputs[];
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index >= uint(inputs.length()) || index >= uint(outputs.length())) {
        return;
    }
    const RockRainImpactTestInput inputValue = inputs[index];
    if (inputValue.control.y == 2u) {
        float peak = 0.0;
        float remaining = 1.0;
        const uint count = min(inputValue.control.z, 4u);
        for (uint valueIndex = 0u; valueIndex < count; ++valueIndex) {
            const float value = inputValue.eventPositionRadius[valueIndex];
            peak = max(peak, value);
            remaining *= 1.0 - clamp(value, 0.0, 1.0);
        }
        outputs[index] = max(peak, 1.0 - remaining);
    } else if (inputValue.control.y == 1u) {
        outputs[index] = EvaluateSandRainImpactValue(
            inputValue.eventPositionRadius.xyz,
            inputValue.eventPositionRadius.w,
            inputValue.eventNormalLifetime.w,
            inputValue.pointAge.xyz,
            inputValue.pointAge.w,
            inputValue.rockImpact0.x);
    } else {
        outputs[index] = EvaluateRockRainImpactValue(
            inputValue.eventPositionRadius.xyz,
            inputValue.eventNormalLifetime.xyz,
            inputValue.eventPositionRadius.w,
            inputValue.eventNormalLifetime.w,
            inputValue.control.x,
            inputValue.rockImpact0,
            inputValue.rockImpact1,
            // Downhill stretch travels in the point-normal spare lane.
            inputValue.pointNormal.w,
            inputValue.pointAge.xyz,
            inputValue.pointNormal.xyz,
            inputValue.pointAge.w);
    }
}
