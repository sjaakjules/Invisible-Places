struct GroundQuery {
    vec3 position;
    vec3 normal;
    vec3 downhill;
    float convergence;
    float confidence;
    uint flags;
    uint component;
    uint connectivity;
    ivec2 coordinate;
    uint slotIndex;
    uint valid;
};

struct MeshFlowVisualWeights {
    float spawnAcceptance;
    float noiseScale;
    float trailProminence;
    float trailWidthScale;
    float trailStreakScale;
};

uint HashBits(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

uint RotateLeft(uint value, uint count) {
    return (value << count) | (value >> (32u - count));
}

uint HashCell(ivec2 coordinate) {
    uint hash = HashBits(uint(coordinate.x));
    hash ^= RotateLeft(HashBits(uint(coordinate.y)), 11u);
    hash ^= RotateLeft(HashBits(0u), 22u);
    return HashBits(hash);
}

float Hash01(uint a, uint b, uint c) {
    const uint value =
        HashBits(a ^ (b * 0x9e3779b9u) ^ (c * 0x85ebca6bu));
    return float(value & 0x00ffffffu) / 16777215.0;
}

vec3 SafeNormalize(vec3 value, vec3 fallback) {
    const float lengthSquared = dot(value, value);
    return lengthSquared > 1.0e-10
        ? value * inversesqrt(lengthSquared)
        : fallback;
}

vec3 DecodeDirection(uint packed) {
    const vec3 value = vec3(
        float(packed & 1023u),
        float((packed >> 10u) & 1023u),
        float((packed >> 20u) & 1023u)) / 1023.0;
    return SafeNormalize(
        value * 2.0 - 1.0,
        vec3(0.0, 0.0, 1.0));
}

bool FindGroundSlotIndexed(
    ivec2 coordinate,
    out WaterGroundSlot result,
    out uint slotIndex) {
    const uint mask = uniforms.ground.x;
    const uint initial = HashCell(coordinate) & mask;
    const uint probeLimit = min(64u, max(1u, uniforms.ground.y));
    for (uint probe = 0u; probe < probeLimit; ++probe) {
        const uint candidateIndex = (initial + probe) & mask;
        const WaterGroundSlot candidate =
            groundTable.slots[candidateIndex];
        if (candidate.cellX == kEmptyCoordinate) {
            return false;
        }
        if (candidate.cellX == coordinate.x &&
            candidate.cellY == coordinate.y) {
            result = candidate;
            slotIndex = candidateIndex;
            return true;
        }
    }
    return false;
}

bool FindGroundSlot(ivec2 coordinate, out WaterGroundSlot result) {
    uint ignoredSlotIndex = 0u;
    return FindGroundSlotIndexed(
        coordinate,
        result,
        ignoredSlotIndex);
}

GroundQuery GroundFromSlot(
    ivec2 coordinate,
    WaterGroundSlot slot,
    uint slotIndex) {
    GroundQuery result;
    const float resolution =
        max(0.001, uniforms.boundsMinimumResolution.w);
    result.position = vec3(
        (vec2(coordinate) + vec2(0.5)) * resolution,
        slot.height + uniforms.motion0.w);
    result.normal = DecodeDirection(slot.packedNormal);
    result.downhill = DecodeDirection(slot.packedDownhill);
    const vec2 convergenceConfidence =
        unpackUnorm2x16(slot.packedConvergenceConfidence);
    result.convergence = convergenceConfidence.x;
    result.confidence = convergenceConfidence.y;
    result.flags = slot.flagsAndSampleCount & 0xffu;
    result.component = slot.componentAndConnectivity >> 8u;
    result.connectivity = slot.componentAndConnectivity & 0xffu;
    result.coordinate = coordinate;
    result.slotIndex = slotIndex;
    result.valid = 1u;
    return result;
}

GroundQuery QueryGround(vec2 xy, int requestedRadius) {
    GroundQuery result;
    result.position = vec3(xy, 0.0);
    result.normal = vec3(0.0, 0.0, 1.0);
    result.downhill = vec3(1.0, 0.0, 0.0);
    result.convergence = 0.0;
    result.confidence = 0.0;
    result.flags = 0u;
    result.component = 0u;
    result.connectivity = 0u;
    result.coordinate = ivec2(0);
    result.slotIndex = 0u;
    result.valid = 0u;

    const float resolution =
        max(0.001, uniforms.boundsMinimumResolution.w);
    const ivec2 centre = ivec2(floor(xy / resolution));
    const int radius = clamp(requestedRadius, 0, 12);
    float bestDistanceSquared = 3.402823466e38;
    WaterGroundSlot bestSlot;
    uint bestSlotIndex = 0u;
    ivec2 bestCoordinate = centre;
    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            const ivec2 coordinate = centre + ivec2(dx, dy);
            WaterGroundSlot candidate;
            uint candidateSlotIndex = 0u;
            if (!FindGroundSlotIndexed(
                    coordinate,
                    candidate,
                    candidateSlotIndex)) {
                continue;
            }
            const vec2 centrePosition =
                (vec2(coordinate) + vec2(0.5)) * resolution;
            const vec2 delta = centrePosition - xy;
            const float distanceSquared = dot(delta, delta);
            if (distanceSquared < bestDistanceSquared) {
                bestDistanceSquared = distanceSquared;
                bestSlot = candidate;
                bestSlotIndex = candidateSlotIndex;
                bestCoordinate = coordinate;
                result.valid = 1u;
            }
        }
    }
    if (result.valid == 0u) {
        return result;
    }

    return GroundFromSlot(
        bestCoordinate,
        bestSlot,
        bestSlotIndex);
}

MeshFlowVisualWeights EvaluateVisualWeights(
    float convergence,
    float moisture,
    float surfaceConfidence) {
    const float wet = clamp(moisture, 0.0, 1.0);
    const float confidence = clamp(surfaceConfidence, 0.0, 1.0);
    const float rill =
        smoothstep(0.18, 0.82, clamp(convergence, 0.0, 1.0));
    const float authoredFocus =
        clamp(uniforms.particleNoise.w, 0.0, 1.0);
    const float focused =
        1.0 - (1.0 - authoredFocus) * (1.0 - authoredFocus);
    const float dryFocus = focused * (1.0 - wet);
    const float concavityAcceptance = 0.02 + 0.98 * rill;
    const float rillCoherence = rill * mix(0.68, 0.92, wet);
    // Activity and the dry appearance uniforms already provide sparsity.
    // Preserve sub-pixel coverage on the flat +X entry band, while making
    // dry convergent cells substantially more persistent than open Ground.
    const float openProminence = 0.12;
    const float rillProminence = mix(0.90, 0.70, wet);

    MeshFlowVisualWeights result;
    result.spawnAcceptance =
        mix(1.0, concavityAcceptance, dryFocus);
    result.noiseScale =
        mix(1.0, 0.25, rillCoherence);
    result.trailProminence =
        mix(openProminence, rillProminence, rill) *
        (0.68 + 0.32 * confidence);
    result.trailWidthScale =
        mix(0.72, 1.15, rill) * mix(0.90, 1.04, wet);
    result.trailStreakScale =
        mix(0.78, 1.05, rill) * mix(0.94, 1.03, wet);
    return result;
}

void RecordRouteAlignment(float alignment) {
    const uint bin = min(
        7u,
        uint(floor(clamp(alignment, 0.0, 1.0) * 8.0)));
    switch (bin) {
        case 0u:
            atomicAdd(counters.alignmentBin0, 1u);
            break;
        case 1u:
            atomicAdd(counters.alignmentBin1, 1u);
            break;
        case 2u:
            atomicAdd(counters.alignmentBin2, 1u);
            break;
        case 3u:
            atomicAdd(counters.alignmentBin3, 1u);
            break;
        case 4u:
            atomicAdd(counters.alignmentBin4, 1u);
            break;
        case 5u:
            atomicAdd(counters.alignmentBin5, 1u);
            break;
        case 6u:
            atomicAdd(counters.alignmentBin6, 1u);
            break;
        default:
            atomicAdd(counters.alignmentBin7, 1u);
            break;
    }
}

GroundQuery QueryVegetationGroundBelow(
    vec3 seedPosition,
    int requestedRadius) {
    GroundQuery best = QueryGround(seedPosition.xy, 0);
    best.valid = 0u;
    const float resolution =
        max(0.001, uniforms.boundsMinimumResolution.w);
    const ivec2 centre =
        ivec2(floor(seedPosition.xy / resolution));
    const int radius = clamp(requestedRadius, 0, 12);
    float bestScore = 3.402823466e38;
    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            const ivec2 coordinate = centre + ivec2(dx, dy);
            WaterGroundSlot slot;
            uint slotIndex = 0u;
            if (!FindGroundSlotIndexed(
                    coordinate,
                    slot,
                    slotIndex)) {
                continue;
            }
            const GroundQuery candidate =
                GroundFromSlot(coordinate, slot, slotIndex);
            if ((candidate.flags & kVegetationSupportedFlag) == 0u ||
                candidate.position.z > seedPosition.z + 0.02) {
                continue;
            }
            const vec2 delta = candidate.position.xy - seedPosition.xy;
            const float planarDistanceSquared = dot(delta, delta);
            // Prefer the closest vegetation-supported column, then the
            // highest Ground surfel beneath the leaf collision.
            const float heightPenalty =
                max(0.0, seedPosition.z - candidate.position.z) *
                resolution * 0.01;
            const float score = planarDistanceSquared + heightPenalty;
            if (score < bestScore) {
                bestScore = score;
                best = candidate;
            }
        }
    }
    return best;
}

bool SelectConnectedGroundStep(
    GroundQuery current,
    vec3 previousVelocity,
    uint particleIndex,
    float particleSeed,
    out GroundQuery selected,
    out bool terminalContact) {
    const ivec2 offsets[8] = ivec2[8](
        ivec2(0, 1),
        ivec2(1, 1),
        ivec2(1, 0),
        ivec2(1, -1),
        ivec2(0, -1),
        ivec2(-1, -1),
        ivec2(-1, 0),
        ivec2(-1, 1));
    selected = current;
    terminalContact = false;
    bool found = false;
    float bestScore = -3.402823466e38;
    const vec2 downhill = SafeNormalize(
        vec3(current.downhill.xy, 0.0),
        vec3(1.0, 0.0, 0.0)).xy;
    const vec2 prior = SafeNormalize(
        vec3(previousVelocity.xy, 0.0),
        vec3(downhill, 0.0)).xy;
    const vec2 crossSlope = vec2(-downhill.y, downhill.x);
    const float particlePhase =
        dot(
            current.position.xy /
                max(0.001, uniforms.particleNoise.y),
            vec2(0.754877666, 0.569840296)) +
        uniforms.timing.x * uniforms.particleNoise.z +
        particleSeed * 6.28318530718;
    const float sharedPhase =
        dot(
            current.position.xy /
                max(0.001, uniforms.sharedWind.y),
            vec2(0.371, 0.819)) +
        uniforms.timing.x * uniforms.sharedWind.z;
    const MeshFlowVisualWeights currentWeights =
        EvaluateVisualWeights(
            current.convergence,
            uniforms.timing.w,
            current.confidence);
    const float signedCrossNoise = clamp(
        (sin(particlePhase) * uniforms.particleNoise.x +
         sin(sharedPhase) * uniforms.sharedWind.x) *
            currentWeights.noiseScale,
        -1.0,
        1.0);

    for (uint neighbourIndex = 0u;
         neighbourIndex < 8u;
         ++neighbourIndex) {
        if ((current.connectivity & (1u << neighbourIndex)) == 0u) {
            continue;
        }
        const ivec2 coordinate =
            current.coordinate + offsets[neighbourIndex];
        WaterGroundSlot slot;
        uint slotIndex = 0u;
        if (!FindGroundSlotIndexed(
                coordinate,
                slot,
                slotIndex)) {
            continue;
        }
        const GroundQuery candidate =
            GroundFromSlot(coordinate, slot, slotIndex);
        if (candidate.component != current.component) {
            continue;
        }
        const vec3 delta = candidate.position - current.position;
        if (delta.z > 0.010) {
            continue;
        }
        const vec2 direction = SafeNormalize(
            vec3(delta.xy, 0.0),
            vec3(downhill, 0.0)).xy;
        const float downhillAlignment = dot(direction, downhill);
        // Noise and wind only choose between cross-slope downhill options;
        // neither can turn a particle back uphill.
        if (downhillAlignment < -0.001) {
            continue;
        }
        const float inertiaAlignment =
            max(0.0, dot(direction, prior));
        const float tunedDownhillAlignment = pow(
            clamp(downhillAlignment, 0.0, 1.0),
            clamp(
                1.75 / max(0.05, uniforms.motion0.y),
                0.35,
                3.0));
        const float tunedInertiaAlignment = mix(
            0.5,
            inertiaAlignment,
            clamp(uniforms.motion0.z, 0.0, 0.98));
        const float crossAlignment =
            dot(direction, crossSlope);
        const float noisePreference =
            0.5 + 0.5 * crossAlignment * signedCrossNoise;
        const float score =
            0.55 * tunedDownhillAlignment +
            0.25 * tunedInertiaAlignment +
            0.15 * clamp(candidate.convergence, 0.0, 1.0) +
            0.05 * clamp(noisePreference, 0.0, 1.0) +
            Hash01(
                uniforms.ground.w,
                particleIndex,
                neighbourIndex + 101u) *
                1.0e-5;

        const float normalZ =
            abs(current.normal.z) > 0.15
                ? current.normal.z
                : (current.normal.z < 0.0 ? -0.15 : 0.15);
        const float predictedDeltaZ =
            -(current.normal.x * delta.x +
              current.normal.y * delta.y) /
            normalZ;
        const float actualDrop = max(0.0, -delta.z);
        const float maximumExpectedDrop =
            max(0.030, max(0.0, -predictedDeltaZ) + 0.020);
        const bool candidateContact =
            ((current.flags | candidate.flags) &
             kTerminalContactFlag) != 0u ||
            actualDrop > maximumExpectedDrop;
        if (!found || score > bestScore) {
            found = true;
            bestScore = score;
            selected = candidate;
            terminalContact = candidateContact;
        }
    }
    return found;
}

void StoreField(uint slot, uint pointIndex, float value) {
    if (slot < 31u && pointIndex < uniforms.capacities.z) {
        outputScalars.values[
            slot * uniforms.capacities.z + pointIndex] = value;
    }
}

float LoadField(uint slot, uint pointIndex, float fallback) {
    if (slot < 31u && pointIndex < uniforms.capacities.z) {
        return outputScalars.values[
            slot * uniforms.capacities.z + pointIndex];
    }
    return fallback;
}

void StoreTrailPoint(
    uint pointIndex,
    vec3 position,
    vec3 normal,
    float role,
    float trailId,
    float sourceId,
    float routeStart,
    float routeCount,
    float routeLength,
    float trailDistance,
    float phase,
    float pointAge,
    float speed,
    float confidence,
    float widthScale,
    float streakScale,
    vec3 tangent,
    float seed) {
    if (pointIndex >= uniforms.capacities.z) {
        return;
    }
    outputPositions.positions[pointIndex] = vec4(position, 1.0);
    outputNormals.normals[pointIndex] =
        vec4(SafeNormalize(normal, vec3(0.0, 0.0, 1.0)), 0.0);
    StoreField(kTrailRoleFieldSlot, pointIndex, role);
    StoreField(kTrailIdFieldSlot, pointIndex, trailId);
    StoreField(kSourceIdFieldSlot, pointIndex, sourceId);
    StoreField(kPathIdFieldSlot, pointIndex, trailId);
    StoreField(kBranchIdFieldSlot, pointIndex, 0.0);
    StoreField(kTrailSeedFieldSlot, pointIndex, seed);
    StoreField(kPointSeedFieldSlot, pointIndex, fract(seed + pointAge * 1.61803398875));
    StoreField(kTrailDistanceFieldSlot, pointIndex, trailDistance);
    StoreField(kTrailLengthFieldSlot, pointIndex, max(0.001, routeLength));
    StoreField(kRouteStartFieldSlot, pointIndex, routeStart);
    StoreField(kRouteCountFieldSlot, pointIndex, routeCount);
    StoreField(kRouteLengthFieldSlot, pointIndex, max(0.001, routeLength));
    StoreField(kTrailStartPhaseFieldSlot, pointIndex, phase);
    StoreField(kTrailLateralOffsetFieldSlot, pointIndex, 0.0);
    StoreField(kPointAgeFieldSlot, pointIndex, pointAge);
    StoreField(kTrailAgeFieldSlot, pointIndex, pointAge);
    StoreField(kTrailSpeedFieldSlot, pointIndex, max(0.01, speed));
    StoreField(
        kTrailWidthFieldSlot,
        pointIndex,
        max(0.0005, uniforms.visual.x * max(0.10, widthScale)));
    StoreField(
        kTrailStreakLengthFieldSlot,
        pointIndex,
        max(0.001, uniforms.visual.y * max(0.10, streakScale)));
    StoreField(kTrailConfidenceFieldSlot, pointIndex, clamp(confidence, 0.0, 1.0));
    // Trails ARE water: the wetness floor keeps them reading wet (visible
    // opacity/emission) even when the scenario itself is dry.
    StoreField(
        kWetnessFieldSlot,
        pointIndex,
        clamp(
            max(uniforms.timing.w, uniforms.responsePersistence.w),
            0.0,
            1.0));
    StoreField(kFeatureTypeFieldSlot, pointIndex, uniforms.visual.z);
    StoreField(kTangentXFieldSlot, pointIndex, tangent.x);
    StoreField(kTangentYFieldSlot, pointIndex, tangent.y);
    StoreField(kTangentZFieldSlot, pointIndex, tangent.z);
    StoreField(kLaneIndexFieldSlot, pointIndex, 0.0);
    StoreField(kLaneCountFieldSlot, pointIndex, 1.0);
    StoreField(kLanePitchFieldSlot, pointIndex, max(0.0001, uniforms.visual.x * 2.0));
    StoreField(kLaneSpanFieldSlot, pointIndex, max(uniforms.visual.x * 8.0, 0.001));
    StoreField(kLaneCrossingFieldSlot, pointIndex, 0.0);
    StoreField(kCrossSeedFieldSlot, pointIndex, seed);
}

void HideParticleRange(uint particleIndex, vec3 fallbackPosition) {
    const uint historyLength = uniforms.capacities.y;
    const uint stride = historyLength + 1u;
    const uint routeStart = particleIndex * stride;
    for (uint offset = 0u; offset < stride; ++offset) {
        StoreTrailPoint(
            routeStart + offset,
            fallbackPosition,
            vec3(0.0, 0.0, 1.0),
            0.0,
            float(particleIndex + 1u),
            0.0,
            float(routeStart),
            float(historyLength),
            0.001,
            0.0,
            0.0,
            1.0,
            0.01,
            0.0,
            1.0,
            1.0,
            vec3(1.0, 0.0, 0.0),
            Hash01(uniforms.ground.w, particleIndex, 7u));
    }
}

GroundQuery SpawnParticle(
    uint particleIndex,
    uint previousSourceKind,
    uint previousSourceSlot,
    out vec3 initialVelocity,
    out uint sourceId,
    out uint sourceKind) {
    initialVelocity = vec3(1.0, 0.0, 0.0);
    sourceId = 0u;
    sourceKind = 0u;

    // Preserve rain-fed emergence across the moisture recession without
    // rescanning the seed ring.  The hash-table slot is stable for the
    // lifetime of the installed Ground revision; a cache replacement also
    // advances the Mesh reset epoch and clears this remembered slot.
    if (previousSourceKind == 1u &&
        uniforms.timing.w > 0.001 &&
        previousSourceSlot <
            uint(groundTable.slots.length())) {
        const WaterGroundSlot rememberedSlot =
            groundTable.slots[previousSourceSlot];
        if (rememberedSlot.cellX != kEmptyCoordinate) {
            const ivec2 rememberedCoordinate =
                ivec2(
                    rememberedSlot.cellX,
                    rememberedSlot.cellY);
            const GroundQuery remembered =
                GroundFromSlot(
                    rememberedCoordinate,
                    rememberedSlot,
                    previousSourceSlot);
            if ((remembered.flags &
                    kVegetationSupportedFlag) != 0u) {
                initialVelocity = remembered.downhill;
                sourceId = previousSourceSlot;
                sourceKind = 1u;
                return remembered;
            }
        }
    }

    // Rain-fed emergence samples a bounded fixed ring written by the Rain
    // compute pass. Each particle checks at most four deterministic entries;
    // stale reset epochs and impacts outside the installed Ground disappear
    // without a CPU readback or a per-frame seed upload.
    const uint writeCount = rainVegetationSeeds.header.x;
    const uint availableRainSeeds =
        min(writeCount, kRainSeedCapacity);
    const float rainSourceFraction =
        clamp(uniforms.vegetationExtra.w, 0.0, 1.0) *
        clamp(uniforms.timing.w, 0.0, 1.0);
    const bool preferRainSource =
        availableRainSeeds > 0u &&
        Hash01(uniforms.ground.w, particleIndex, 37u) <
            rainSourceFraction;
    if (preferRainSource) {
        const float rainSpawnSpread =
            clamp(uniforms.sharedWind.w, 0.0, 1.0);
        const uint rainAttemptCount =
            1u + uint(round(rainSpawnSpread * 3.0));
        for (uint attempt = 0u; attempt < 4u; ++attempt) {
            if (attempt >= rainAttemptCount) {
                break;
            }
            const float ageSample = Hash01(
                uniforms.ground.w,
                particleIndex,
                attempt + 41u);
            const float distributedAgeSample = mix(
                ageSample * ageSample * ageSample,
                ageSample,
                rainSpawnSpread);
            const uint ageIndex =
                uint(floor(
                    distributedAgeSample *
                    float(availableRainSeeds)));
            const uint logicalIndex =
                writeCount - 1u -
                min(ageIndex, availableRainSeeds - 1u);
            const MeshFlowRainSeed rainSeed =
                rainVegetationSeeds.seeds[
                    logicalIndex % kRainSeedCapacity];
            const float seedAge =
                uniforms.timing.x - rainSeed.positionBirth.w;
            if (rainSeed.metadata.w == 0u ||
                rainSeed.metadata.z != uniforms.control.w ||
                seedAge < 0.0 ||
                seedAge > 120.0) {
                continue;
            }
            const float spreadAngle =
                Hash01(
                    rainSeed.metadata.y,
                    particleIndex,
                    attempt + 151u) *
                6.28318530718;
            const float spreadRadius =
                sqrt(
                    Hash01(
                        rainSeed.metadata.y,
                        particleIndex,
                        attempt + 157u)) *
                rainSpawnSpread * 0.12;
            vec3 distributedSeedPosition =
                rainSeed.positionBirth.xyz;
            distributedSeedPosition.xy +=
                vec2(cos(spreadAngle), sin(spreadAngle)) *
                spreadRadius;
            const int groundSearchRadius =
                2 + int(round(rainSpawnSpread * 10.0));
            GroundQuery rainSpawn =
                QueryVegetationGroundBelow(
                    distributedSeedPosition,
                    groundSearchRadius);
            if (rainSpawn.valid == 0u) {
                continue;
            }
            // The VEG crown remains the first visible response.  Do not
            // emerge onto Ground until the existing leaf-to-leaf propagation
            // could have descended from the collision to this surfel.
            const float leafDescentMeters =
                max(
                    0.0,
                    rainSeed.positionBirth.z -
                        rainSpawn.position.z);
            const float leafDescentSeconds =
                leafDescentMeters / 0.65;
            if (seedAge < leafDescentSeconds) {
                continue;
            }
            initialVelocity = rainSpawn.downhill;
            sourceId = rainSpawn.slotIndex;
            sourceKind = 1u;
            return rainSpawn;
        }
    }

    const uint entryCount = min(
        uniforms.control.z,
        uint(groundEntries.entries.length()));
    GroundQuery best = QueryGround(
        uniforms.boundsMinimumResolution.xy,
        0);
    best.valid = 0u;
    GroundQuery fallback = best;
    float bestScore = -3.402823466e38;
    float fallbackScore = -3.402823466e38;
    const uint sampleCount = min(8u, entryCount);
    for (uint sampleIndex = 0u;
         sampleIndex < sampleCount;
         ++sampleIndex) {
        const float entrySample = Hash01(
            uniforms.ground.w,
            particleIndex,
            sampleIndex + 71u);
        const uint candidateIndex = min(
            entryCount - 1u,
            uint(
                floor(
                    entrySample * entrySample * entrySample *
                    float(entryCount))));
        const MeshFlowGroundEntry entry =
            groundEntries.entries[candidateIndex];
        WaterGroundSlot slot;
        uint slotIndex = 0u;
        if (!FindGroundSlotIndexed(
                entry.coordinate,
                slot,
                slotIndex)) {
            continue;
        }
        const GroundQuery candidate =
            GroundFromSlot(
                entry.coordinate,
                slot,
                slotIndex);
        if ((candidate.flags & kVegetationSupportedFlag) == 0u) {
            continue;
        }
        const MeshFlowVisualWeights candidateWeights =
            EvaluateVisualWeights(
                candidate.convergence,
                uniforms.timing.w,
                candidate.confidence);
        const float spawnSelection = Hash01(
            uniforms.ground.w ^ candidate.slotIndex,
            particleIndex,
            sampleIndex + 83u);
        const float score =
            candidate.convergence * 0.78 +
            candidate.confidence * 0.12 +
            Hash01(
                uniforms.ground.w,
                particleIndex,
                sampleIndex + 61u) *
                0.10;
        // The dry focus is a source-location weighting, not a population
        // throttle. Prefer candidates which pass the deterministic
        // acceptance gate, but fall back to the strongest sampled rill so the
        // activity² population budget remains stable and visible.
        const float weightedFallbackScore =
            score +
            candidateWeights.spawnAcceptance * 0.35;
        if (weightedFallbackScore > fallbackScore) {
            fallbackScore = weightedFallbackScore;
            fallback = candidate;
        }
        if (spawnSelection >
            candidateWeights.spawnAcceptance) {
            continue;
        }
        if (score > bestScore) {
            bestScore = score;
            best = candidate;
        }
    }
    if (best.valid == 0u) {
        best = fallback;
    }
    if (best.valid != 0u) {
        initialVelocity = best.downhill;
        sourceId = best.slotIndex;
    }
    return best;
}

void main() {
    const uint particleIndex = gl_GlobalInvocationID.x;
    const uint particleCapacity = uniforms.capacities.x;
    const uint historyLength = max(2u, uniforms.capacities.y);
    if (particleIndex >= particleCapacity ||
        uniforms.capacities.z == 0u ||
        uniforms.ground.z == 0u) {
        return;
    }
    if (particleIndex == 0u) {
        counters.availableRainSeedCount =
            min(rainVegetationSeeds.header.x, kRainSeedCapacity);
    }

    MeshFlowParticle particle = particleStates.particles[particleIndex];
    const bool reset =
        particle.metadata.w != uniforms.control.x;
    if (reset) {
        particle.metadata = uvec4(0u, 0u, 0u, uniforms.control.x);
        contactEvents.events[particleIndex].positionTime.w = -3.402823466e38;
    }

    const float now = uniforms.timing.x;
    MeshFlowContactEvent previousEvent =
        contactEvents.events[particleIndex];
    const bool vegetationEvent =
        (previousEvent.metadata.y & kVegetationSupportedFlag) != 0u;
    const float previousPersistence = vegetationEvent
        ? uniforms.responsePersistence.y
        : uniforms.responsePersistence.x;
    const bool previousEventActive =
        previousEvent.positionTime.w > -1.0e30 &&
        now - previousEvent.positionTime.w <= max(0.01, previousPersistence);
    if (previousEventActive) {
        atomicAdd(counters.contactEventCount, 1u);
    }

    const float activity =
        clamp(uniforms.timing.z, 0.0, 1.0);
    const float moisture =
        clamp(uniforms.timing.w, 0.0, 1.0);
    const float populationFraction =
        activity * activity * mix(0.125, 0.50, moisture);
    const bool populationEligible =
        Hash01(uniforms.ground.w, particleIndex, 31u) <
        populationFraction;
    if (populationEligible) {
        // Report the stable hashed population, including staggered births and
        // terminal fades. This is the settled population budget; transient
        // lifecycle states must not produce a synchronized count flash.
        atomicAdd(counters.activeParticleCount, 1u);
    }
    if (!populationEligible) {
        if (particle.metadata.x == kParticleFlowing) {
            particle.metadata.x = kParticleFading;
            particle.positionAge.w = 0.0;
        } else if (particle.metadata.x != kParticleFading) {
            particle.metadata.x = kParticleInactive;
            particleStates.particles[particleIndex] = particle;
            HideParticleRange(
                particleIndex,
                particle.positionAge.xyz);
            return;
        }
    }

    if (particle.metadata.x == kParticleInactive) {
        particle.metadata.x = kParticleWaiting;
        particle.positionAge.w =
            now +
            Hash01(uniforms.ground.w, particleIndex, 33u) * 2.0;
        particleStates.particles[particleIndex] = particle;
        HideParticleRange(particleIndex, particle.positionAge.xyz);
        return;
    }
    if (particle.metadata.x == kParticleWaiting) {
        if (now < particle.positionAge.w) {
            particleStates.particles[particleIndex] = particle;
            HideParticleRange(particleIndex, particle.positionAge.xyz);
            return;
        }
        particle.metadata.x = kParticleInactive;
    }

    if (particle.metadata.x == kParticleFading) {
        const float fadeDuration = max(0.01, uniforms.visual.w);
        particle.positionAge.w += max(0.0, uniforms.timing.y);
        const float terminalFade =
            1.0 - smoothstep(
                0.0,
                fadeDuration,
                particle.positionAge.w);
        const uint fadeStride = historyLength + 1u;
        const uint fadeStart = particleIndex * fadeStride;
        for (uint anchor = 0u; anchor < fadeStride; ++anchor) {
            StoreField(
                kTrailRoleFieldSlot,
                fadeStart + anchor,
                uniforms.control.y != 0u ? 1.0 : 0.0);
            StoreField(
                kTrailConfidenceFieldSlot,
                fadeStart + anchor,
                min(
                    terminalFade,
                    LoadField(
                        kTrailConfidenceFieldSlot,
                        fadeStart + anchor,
                        terminalFade)));
        }
        if (particle.positionAge.w >= fadeDuration) {
            particle.metadata.x = kParticleInactive;
        }
        particleStates.particles[particleIndex] = particle;
        return;
    }

    bool spawned = false;
    if (particle.metadata.x == kParticleInactive) {
        vec3 initialVelocity;
        uint sourceId;
        uint sourceKind;
        const GroundQuery spawn = SpawnParticle(
            particleIndex,
            particle.metadata.y,
            particle.metadata.z,
            initialVelocity,
            sourceId,
            sourceKind);
        if (spawn.valid == 0u) {
            particle.metadata.x = kParticleInactive;
            particleStates.particles[particleIndex] = particle;
            HideParticleRange(
                particleIndex,
                uniforms.boundsMinimumResolution.xyz);
            return;
        }
        particle.positionAge = vec4(spawn.position, 0.0);
        particle.velocityDistance =
            vec4(
                SafeNormalize(spawn.downhill, initialVelocity),
                0.0);
        particle.normalConfidence =
            vec4(spawn.normal, 0.0);
        particle.metadata =
            uvec4(
                kParticleFlowing,
                sourceKind,
                sourceId,
                uniforms.control.x);
        spawned = true;
    }

    const uint stride = historyLength + 1u;
    const uint routeStart = particleIndex * stride;
    if (spawned) {
        for (uint anchor = 0u; anchor < historyLength; ++anchor) {
            outputPositions.positions[routeStart + anchor] =
                vec4(particle.positionAge.xyz, 1.0);
            outputNormals.normals[routeStart + anchor] =
                vec4(particle.normalConfidence.xyz, 0.0);
        }
    }

    const GroundQuery current =
        QueryGround(particle.positionAge.xy, 2);
    if (current.valid == 0u) {
        particle.metadata.x = kParticleInactive;
        particleStates.particles[particleIndex] = particle;
        HideParticleRange(particleIndex, particle.positionAge.xyz);
        return;
    }

    const float seed =
        Hash01(uniforms.ground.w, particleIndex, 29u);
    const vec3 previousVelocity = SafeNormalize(
        particle.velocityDistance.xyz,
        current.downhill);
    const float speed =
        max(0.001, uniforms.motion0.x) *
        mix(0.72, 1.35, current.convergence);
    const float resolution =
        max(0.001, uniforms.boundsMinimumResolution.w);
    float stepBudget =
        particle.normalConfidence.w +
        speed * max(0.0, uniforms.timing.y);
    GroundQuery next = current;
    bool terminalContact =
        (current.flags & kTerminalContactFlag) != 0u;
    bool selectedNext = false;
    if (!terminalContact && stepBudget >= resolution) {
        selectedNext = SelectConnectedGroundStep(
            current,
            previousVelocity,
            particleIndex,
            seed,
            next,
            terminalContact);
        if (!selectedNext) {
            particle.metadata.x = kParticleInactive;
            particleStates.particles[particleIndex] = particle;
            HideParticleRange(particleIndex, particle.positionAge.xyz);
            return;
        }
    }

    vec3 velocity = previousVelocity;
    GroundQuery trailSurface = current;
    vec3 renderedStepDelta = vec3(0.0);
    float renderedStepLength = 0.0;
    if (selectedNext && !terminalContact) {
        for (uint anchor = 0u; anchor + 1u < historyLength; ++anchor) {
            outputPositions.positions[routeStart + anchor] =
                outputPositions.positions[routeStart + anchor + 1u];
            outputNormals.normals[routeStart + anchor] =
                outputNormals.normals[routeStart + anchor + 1u];
        }
        const float stepDistance =
            length(next.position - current.position);
        renderedStepDelta =
            next.position - current.position;
        renderedStepLength = stepDistance;
        velocity = SafeNormalize(
            next.position - current.position,
            previousVelocity);
        particle.positionAge =
            vec4(
                next.position,
                particle.positionAge.w + uniforms.timing.y);
        particle.velocityDistance =
            vec4(
                velocity,
                particle.velocityDistance.w + stepDistance);
        particle.normalConfidence =
            vec4(
                next.normal,
                max(0.0, stepBudget - max(resolution, stepDistance)));
        trailSurface = next;
    } else {
        particle.positionAge.w += max(0.0, uniforms.timing.y);
        particle.normalConfidence.w = stepBudget;
    }
    outputPositions.positions[
        routeStart + historyLength - 1u] =
        vec4(trailSurface.position, 1.0);
    outputNormals.normals[
        routeStart + historyLength - 1u] =
        vec4(trailSurface.normal, 0.0);

    atomicAdd(counters.routeSampleCount, 1u);
    const vec3 boundsPadding = vec3(0.015);
    if (all(greaterThanEqual(
            trailSurface.position,
            uniforms.boundsMinimumResolution.xyz -
                boundsPadding)) &&
        all(lessThanEqual(
            trailSurface.position,
            uniforms.boundsMaximumBand.xyz +
                boundsPadding))) {
        atomicAdd(counters.routeWithinBoundsCount, 1u);
    }
    const GroundQuery diagnosticSurface =
        QueryGround(trailSurface.position.xy, 1);
    if (diagnosticSurface.valid != 0u &&
        abs(
            diagnosticSurface.position.z -
            trailSurface.position.z) <= 0.015) {
        atomicAdd(counters.routeNearSurfaceCount, 1u);
    }
    if (renderedStepLength > 0.0) {
        atomicMax(
            counters.maximumSegmentBits,
            floatBitsToUint(renderedStepLength));
        if (renderedStepLength > 0.10) {
            atomicAdd(counters.longSegmentCount, 1u);
        }
        const float planarStep =
            length(renderedStepDelta.xy);
        if (abs(renderedStepDelta.z) > 0.030 &&
            abs(renderedStepDelta.z) >
                planarStep * 1.5) {
            atomicAdd(counters.verticalJumpCount, 1u);
        }
    }
    const vec2 diagnosticTangent = SafeNormalize(
        vec3(velocity.xy, 0.0),
        vec3(1.0, 0.0, 0.0)).xy;
    const vec2 diagnosticDownhill = SafeNormalize(
        vec3(trailSurface.downhill.xy, 0.0),
        vec3(diagnosticTangent, 0.0)).xy;
    RecordRouteAlignment(
        max(0.0, dot(
            diagnosticTangent,
            diagnosticDownhill)));

    float routeLength = 0.0;
    for (uint anchor = 1u; anchor < historyLength; ++anchor) {
        routeLength += length(
            outputPositions.positions[routeStart + anchor].xyz -
            outputPositions.positions[routeStart + anchor - 1u].xyz);
    }
    routeLength = max(0.001, routeLength);
    const float trailId = float(particleIndex + 1u);
    const float sourceId = float(particle.metadata.z);
    MeshFlowVisualWeights nextWeights =
        EvaluateVisualWeights(
            trailSurface.convergence,
            uniforms.timing.w,
            trailSurface.confidence);
    for (uint anchor = 0u; anchor < historyLength; ++anchor) {
        const uint previousAnchor =
            anchor > 0u ? anchor - 1u : anchor;
        const uint nextAnchor =
            min(anchor + 1u, historyLength - 1u);
        const vec3 tangent = SafeNormalize(
            outputPositions.positions[routeStart + nextAnchor].xyz -
            outputPositions.positions[routeStart + previousAnchor].xyz,
            velocity);
        const float anchorT =
            float(anchor) / float(max(1u, historyLength - 1u));
        StoreTrailPoint(
            routeStart + anchor,
            outputPositions.positions[routeStart + anchor].xyz,
            outputNormals.normals[routeStart + anchor].xyz,
            uniforms.control.y != 0u ? 1.0 : 0.0,
            trailId,
            sourceId,
            float(routeStart),
            float(historyLength),
            routeLength,
            routeLength * anchorT,
            anchorT,
            1.0 - anchorT,
            speed,
            nextWeights.trailProminence,
            nextWeights.trailWidthScale,
            nextWeights.trailStreakScale,
            tangent,
            seed);
    }

    StoreTrailPoint(
        routeStart + historyLength,
        trailSurface.position,
        trailSurface.normal,
        uniforms.control.y != 0u ? 1.0 : 0.0,
        trailId,
        sourceId,
        float(routeStart),
        float(historyLength),
        routeLength,
        routeLength,
        seed,
        0.0,
        speed,
        nextWeights.trailProminence,
        nextWeights.trailWidthScale,
        nextWeights.trailStreakScale,
        velocity,
        seed);

    if (terminalContact) {
        const bool vegetation =
            (next.flags & kVegetationSupportedFlag) != 0u;
        const vec4 response = vegetation
            ? uniforms.vegetationResponse
            : uniforms.rockResponse;
        const vec4 colour = vegetation
            ? uniforms.vegetationColour
            : uniforms.rockColour;
        MeshFlowContactEvent event;
        event.positionTime = vec4(next.position, now);
        // Radius and the tunable upward reach share one lane as half floats;
        // the contact include unpacks them.
        event.normalRadius = vec4(
            next.normal,
            uintBitsToFloat(packHalf2x16(vec2(
                max(0.0, response.x),
                max(0.0, uniforms.vegetationExtra.z)))));
        event.metadata = uvec4(
            particleIndex,
            next.flags,
            packUnorm4x8(clamp(colour, 0.0, 1.0)),
            vegetation ? 1u : 0u);
        event.response = vec4(
            max(0.0, response.y),
            max(0.0, response.z),
            max(0.01, response.w),
            vegetation ? max(0.0, uniforms.vegetationExtra.x) : 0.0);
        event.vegetationExtra = vec4(
            vegetation
                ? max(0.0, uniforms.vegetationExtra.y)
                : max(response.x * 2.6, 0.16),
            clamp(uniforms.timing.w, 0.0, 1.0),
            clamp(next.convergence, 0.0, 1.0),
            seed);
        contactEvents.events[particleIndex] = event;
        // Splat the event into every bucket its response radius overlaps so
        // readers only scan their own 3x3 neighborhood and the effect never
        // clips at cell boundaries. The lane is stable per particle (no time
        // term) so repeated contacts do not churn unrelated references.
        const float contactCellSize =
            max(0.05, uniforms.responsePersistence.z);
        const ivec2 contactCoordinate =
            ivec2(floor(next.position.xy / contactCellSize));
        const int splatRange = clamp(
            int(ceil(max(0.0, response.x) / contactCellSize)),
            0,
            3);
        const uint contactLane = HashBits(particleIndex) & 3u;
        const uint eventIndexPlusOne = particleIndex + 1u;
        for (int splatY = -splatRange; splatY <= splatRange; ++splatY) {
            for (int splatX = -splatRange; splatX <= splatRange; ++splatX) {
                const uint contactBucket =
                    HashCell(contactCoordinate + ivec2(splatX, splatY)) &
                    uniforms.contactGrid.x;
                if (contactLane == 0u) {
                    atomicExchange(
                        contactGrid.eventIndicesPlusOne[contactBucket].x,
                        eventIndexPlusOne);
                } else if (contactLane == 1u) {
                    atomicExchange(
                        contactGrid.eventIndicesPlusOne[contactBucket].y,
                        eventIndexPlusOne);
                } else if (contactLane == 2u) {
                    atomicExchange(
                        contactGrid.eventIndicesPlusOne[contactBucket].z,
                        eventIndexPlusOne);
                } else {
                    atomicExchange(
                        contactGrid.eventIndicesPlusOne[contactBucket].w,
                        eventIndexPlusOne);
                }
            }
        }
        atomicAdd(counters.terminalContactCount, 1u);
        if (!previousEventActive) {
            atomicAdd(counters.contactEventCount, 1u);
        }
        particle.metadata.x = kParticleFading;
        particle.positionAge.w = 0.0;
    } else {
        if (particle.metadata.y == 1u) {
            atomicAdd(counters.rainSeedParticleCount, 1u);
        }
    }
    particleStates.particles[particleIndex] = particle;
}
